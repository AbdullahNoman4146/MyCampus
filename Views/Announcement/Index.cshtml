@model IEnumerable<MyCampus.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
    var selectedPri = ViewBag.SelectedPriority as string ?? "All";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-white mb-0">Announcements</h2>
    </div>
    <a asp-action="Create" class="btn-gradient-primary">
        <i class="bi bi-plus-lg me-1"></i> Post Announcement
    </a>
</div>

<!-- Filters Bar: Search & Priority Pills -->
<div class="glass-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-12 col-lg-6">
            <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search notices by keyword, title, or author..." />
        </div>
        <div class="col-12 col-lg-6 d-flex flex-wrap align-items-center justify-content-lg-end gap-2">
            <span class="text-muted small fw-bold text-uppercase me-1">Priority:</span>
            <button type="submit" name="priority" value="All" class="day-tab-btn @(selectedPri == "All" || string.IsNullOrEmpty(selectedPri) ? "active" : "")">All</button>
            <button type="submit" name="priority" value="high" class="day-tab-btn @(selectedPri == "high" ? "active" : "")">High</button>
            <button type="submit" name="priority" value="medium" class="day-tab-btn @(selectedPri == "medium" ? "active" : "")">Medium</button>
            <button type="submit" name="priority" value="low" class="day-tab-btn @(selectedPri == "low" ? "active" : "")">Low</button>
            <a asp-action="Index" class="btn-glass btn-sm ms-2">Reset</a>
        </div>
    </form>
</div>

<!-- Notification Stream -->
<div class="d-flex flex-column gap-3">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            var pri = item.Priority?.ToLower() ?? "medium";
            var cardPriorityClass = pri == "high" ? "priority-high" : (pri == "medium" ? "priority-medium" : "priority-low");
            var badgePriorityClass = pri == "high" ? "badge-glow-rose" : (pri == "medium" ? "badge-glow-amber" : "badge-glow-lime");

            <div class="announcement-card @cardPriorityClass p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge-glow @badgePriorityClass text-uppercase">
                            @item.Priority Priority
                        </span>
                        <span class="text-muted small">@item.Date.ToString("MMMM dd, yyyy")</span>
                        @if (!string.IsNullOrEmpty(item.PostedBy))
                        {
                            <span class="badge-glass">@item.PostedBy</span>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@item.AnnouncementId" class="btn-glass btn-sm" title="Edit Notice">
                            <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@item.AnnouncementId" class="btn-glass btn-sm" title="View Details">
                            <i class="bi bi-info-circle me-1"></i> Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.AnnouncementId" class="btn-glass-danger btn-sm" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>

                <h5 class="fw-bold text-white mb-2" style="letter-spacing: -0.3px;">@item.Title</h5>
                <p class="text-secondary mb-2" style="white-space: pre-wrap; font-size: 0.95rem;">@item.Body</p>

                @if (item.Expires.HasValue)
                {
                    <div class="text-end">
                        <span class="text-muted small">Expires on @item.Expires.Value.ToString("MMMM dd, yyyy")</span>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="glass-card text-center py-5">
            <i class="bi bi-megaphone text-muted" style="font-size: 2.5rem;"></i>
            <h5 class="text-white fw-bold mt-2">No Announcements Found</h5>
            <p class="text-secondary small mb-3">No notices match your selected priority or search filter.</p>
            <a asp-action="Index" class="btn-glass">Reset Filters</a>
        </div>
    }
</div>
