@model MyCampus.Models.Announcement

@{
    ViewData["Title"] = "Notice Details";
    var pri = Model.Priority?.ToLower() ?? "medium";
    var priClass = pri == "high" ? "badge-glow-rose" : (pri == "medium" ? "badge-glow-amber" : "badge-glow-lime");
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-7">
        <div class="glass-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper" style="width: 44px; height: 44px; font-size: 1.2rem;">
                        <i class="bi bi-info-circle"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-white">Notice Details</h3>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-glass text-light">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            <div class="p-3 mb-4 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="@priClass text-uppercase fs-6 fw-bold">@Model.Priority Priority</span>
                    <span class="text-secondary small">@Model.Date.ToString("MMMM dd, yyyy")</span>
                </div>
                <h4 class="fw-bold text-white mb-0">@Model.Title</h4>
            </div>

            <div class="p-4 rounded-3 mb-4" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06);">
                <h6 class="text-secondary small fw-bold text-uppercase mb-3">Notice Content:</h6>
                <p class="text-light fs-6 mb-0" style="white-space: pre-wrap; line-height: 1.6;">@Model.Body</p>
            </div>

            <div class="d-flex flex-column gap-3 mb-4">
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                    <span class="text-secondary small">Posted By</span>
                    <span class="fw-semibold text-white">@(string.IsNullOrEmpty(Model.PostedBy) ? "Department / Authority" : Model.PostedBy)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                    <span class="text-secondary small">Expiration Date</span>
                    <span class="fw-semibold text-white">@(Model.Expires.HasValue ? Model.Expires.Value.ToString("MMMM dd, yyyy") : "No expiration set")</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.ExternalId))
                {
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-secondary small">System Reference ID</span>
                        <span class="font-monospace small text-secondary">@Model.ExternalId</span>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-10">
                <a asp-action="Edit" asp-route-id="@Model.AnnouncementId" class="btn btn-gradient-primary px-3">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.AnnouncementId" class="btn btn-glass-danger px-3">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>
            </div>
        </div>
    </div>
</div>
