@model MyCampus.Models.Assignment

@{
    ViewData["Title"] = "Assignment Details";
    var isPending = Model.Status?.ToLower() == "pending";
    var daysLeft = (Model.Deadline.Date - DateTime.Today).TotalDays;
    var dueText = daysLeft < 0 ? "Overdue" : (daysLeft == 0 ? "Due Today" : $"Due in {daysLeft} day{(daysLeft == 1 ? "" : "s")}");
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="glass-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper" style="width: 44px; height: 44px; font-size: 1.2rem;">
                        <i class="bi bi-info-circle"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0 text-white">Assignment Details</h3>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-glass text-light">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            <div class="p-3 mb-4 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="badge-glow badge-glow-purple px-2 py-1 fs-6 fw-bold mb-2 d-inline-block">@Model.Course</span>
                        <h4 class="fw-bold text-white mb-1">@Model.Title</h4>
                        @if (!string.IsNullOrEmpty(Model.CourseTitle))
                        {
                            <div class="text-secondary small">@Model.CourseTitle</div>
                        }
                    </div>
                    <div>
                        @if (isPending)
                        {
                            <span class="badge-glow-amber px-3 py-1 fs-6 fw-semibold">Pending</span>
                        }
                        else
                        {
                            <span class="badge-glow-lime px-3 py-1 fs-6 fw-semibold">Submitted</span>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="p-4 rounded-3 mb-4" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06);">
                    <h6 class="text-secondary small fw-bold text-uppercase mb-3">Instructions:</h6>
                    <p class="text-light fs-6 mb-0" style="white-space: pre-wrap; line-height: 1.6;">@Model.Description</p>
                </div>
            }

            <div class="d-flex flex-column gap-3 mb-4">
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                    <span class="text-secondary small">Deadline</span>
                    <span class="fw-bold @(daysLeft < 2 ? "text-danger" : "text-white")">
                        @Model.Deadline.ToString("MMMM dd, yyyy") (@dueText)
                    </span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                    <span class="text-secondary small">Assigned Date</span>
                    <span class="text-white">@(Model.AssignedDate?.ToString("MMMM dd, yyyy") ?? "N/A")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                    <span class="text-secondary small">Marks</span>
                    <span class="badge-glass px-2 py-1 text-white fw-semibold">@Model.Marks pts</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary border-opacity-10">
                    <span class="text-secondary small">Platform</span>
                    <span class="text-light">@(string.IsNullOrEmpty(Model.SubmissionPlatform) ? "Online" : Model.SubmissionPlatform)</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.ExternalId))
                {
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-secondary small">System Reference ID</span>
                        <span class="font-monospace small text-secondary">@Model.ExternalId</span>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-10">
                <a asp-action="Edit" asp-route-id="@Model.AssignmentId" class="btn btn-gradient-primary px-3">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.AssignmentId" class="btn btn-glass-danger px-3">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>
            </div>
        </div>
    </div>
</div>
