@model IEnumerable<MyCampus.Models.Assignment>

@{
    ViewData["Title"] = "Assignments";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-white mb-0">Assignments</h2>
    </div>
    <a asp-action="Create" class="btn-gradient-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Assignment
    </a>
</div>

<!-- Filters Bar: Search & Status Pills -->
<div class="glass-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-12 col-lg-6">
            <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by course, assignment title, or platform..." />
        </div>
        <div class="col-12 col-lg-6 d-flex flex-wrap align-items-center justify-content-lg-end gap-2">
            <span class="text-muted small fw-bold text-uppercase me-1">Status:</span>
            <button type="submit" name="status" value="All" class="day-tab-btn @(selectedStatus == "All" || string.IsNullOrEmpty(selectedStatus) ? "active" : "")">All</button>
            <button type="submit" name="status" value="pending" class="day-tab-btn @(selectedStatus.Equals("pending", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Pending</button>
            <button type="submit" name="status" value="submitted" class="day-tab-btn @(selectedStatus.Equals("submitted", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Submitted</button>
            <a asp-action="Index" class="btn-glass btn-sm ms-2">Reset</a>
        </div>
    </form>
</div>

<!-- Assignment Tracker Stream -->
<div class="d-flex flex-column gap-3">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            var isPending = item.Status?.ToLower() == "pending";
            var diff = (item.Deadline.Date - DateTime.Today).TotalDays;
            var isOverdue = diff < 0 && isPending;
            var dueText = isOverdue ? "Overdue" : (diff == 0 ? "Due Today" : $"Due in {diff} day{(diff == 1 ? "" : "s")}");
            var dueBadgeClass = isOverdue ? "badge-glow-rose" : (diff <= 2 ? "badge-glow-amber" : "badge-glow-cyan");

            <div class="assignment-card p-4">
                <div class="d-flex flex-column gap-2" style="max-width: 60%;">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="course-code-badge">@item.Course</span>
                        @if (!string.IsNullOrEmpty(item.SubmissionPlatform))
                        {
                            <span class="badge-glass">@item.SubmissionPlatform</span>
                        }
                        @if (item.Marks > 0)
                        {
                            <span class="badge-glass">@item.Marks pts</span>
                        }
                        @if (isPending)
                        {
                            @if (isOverdue)
                            {
                                <span class="badge-glow badge-glow-rose">Overdue</span>
                            }
                            else
                            {
                                <span class="badge-glow badge-glow-amber">Pending</span>
                            }
                        }
                        else
                        {
                            <span class="badge-glow badge-glow-lime">Submitted</span>
                        }
                    </div>

                    <h5 class="fw-bold text-white mb-0" style="letter-spacing: -0.3px;">@item.Title</h5>
                    @if (!string.IsNullOrEmpty(item.CourseTitle))
                    {
                        <div class="text-secondary small">@item.CourseTitle</div>
                    }

                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        <p class="text-muted small mb-0 mt-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Description
                        </p>
                    }
                </div>

                <div class="d-flex flex-column align-items-end justify-content-between gap-3">
                    <div class="text-end">
                        <div class="fw-bold text-white fs-6">@item.Deadline.ToString("MMM dd, yyyy")</div>
                        <span class="badge-glow @dueBadgeClass mt-1">@dueText</span>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@item.AssignmentId" class="btn-glass btn-sm">
                            <i class="bi bi-pencil me-1"></i> Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@item.AssignmentId" class="btn-glass btn-sm">
                            <i class="bi bi-info-circle me-1"></i> Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.AssignmentId" class="btn-glass-danger btn-sm" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="glass-card text-center py-5">
            <i class="bi bi-journal-text text-muted" style="font-size: 2.5rem;"></i>
            <h5 class="text-white fw-bold mt-2">No Assignments Found</h5>
            <p class="text-secondary small mb-3">No assignments match your filter.</p>
            <a asp-action="Index" class="btn-glass">Reset Filters</a>
        </div>
    }
</div>
