@model MyCampus.Models.Room

@{
    ViewData["Title"] = "Room " + Model.RoomNumber + " Details";
    var isAvailable = Model.BookingStatus == "Available";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--border-subtle) !important;">
                <div>
                    <h3 class="fw-bold text-white mb-0">Room @Model.RoomNumber</h3>
                </div>
                <a asp-action="Index" class="btn-glass">&larr; Back to Rooms</a>
            </div>

            <div class="p-3 rounded-3 mb-4" style="background: rgba(255,255,255,0.04); border: 1px solid var(--border-subtle);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge-glow badge-glow-purple text-uppercase">@Model.Type</span>
                        <span class="badge-glass ms-1">Floor @Model.Floor</span>
                    </div>
                    <div>
                        @if (isAvailable)
                        {
                            <span class="status-pill-available">Available</span>
                        }
                        else
                        {
                            <span class="status-pill-booked">@Model.BookingStatus</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column gap-3 mb-4 text-secondary">
                <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                    <span class="text-muted">Seating Capacity</span>
                    <span class="fw-bold text-white fs-5">@Model.Capacity <span class="fs-6 text-muted">seats</span></span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                    <span class="text-muted">Equipment</span>
                    <div class="d-flex flex-wrap gap-1 justify-content-end">
                        @foreach (var eq in (Model.Equipment ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="equipment-pill">@eq.Trim()</span>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.ExternalId))
                {
                    <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                        <span class="text-muted">System Reference ID</span>
                        <span class="badge-glass font-monospace">@Model.ExternalId</span>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: var(--border-subtle) !important;">
                <a asp-controller="RoomBookings" asp-action="Create" asp-route-roomId="@Model.RoomId" class="btn-gradient-primary">
                    Book This Room &rarr;
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn-glass">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.RoomId" class="btn-glass-danger">
                        <i class="bi bi-trash me-1"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
