@model MyCampus.Models.Room

@{
    ViewData["Title"] = "Create Room";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <div class="glass-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper" style="background: rgba(16, 185, 129, 0.15); color: #34D399; width: 46px; height: 46px; font-size: 1.25rem;">
                        <i class="bi bi-door-open"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1 text-white">Add New Room</h3>
                        <p class="text-secondary small mb-0">Register a classroom, laboratory, or seminar facility in SQL Server</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-glass text-light">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger py-2 small rounded-3 mb-4" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="RoomNumber" class="form-label small fw-semibold text-light">Room Number <span class="text-danger">*</span></label>
                        <input asp-for="RoomNumber" class="form-control" placeholder="e.g. 7A08 or 7C06" required />
                        <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Type" class="form-label small fw-semibold text-light">Room Type <span class="text-danger">*</span></label>
                        <select asp-for="Type" class="form-select" required>
                            <option value="classroom">Classroom</option>
                            <option value="lab">Computer / Hardware Lab</option>
                            <option value="seminar">Seminar Hall / Auditorium</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Capacity" class="form-label small fw-semibold text-light">Seating Capacity <span class="text-danger">*</span></label>
                        <input asp-for="Capacity" type="number" class="form-control" placeholder="e.g. 40" min="1" required />
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Floor" class="form-label small fw-semibold text-light">Floor Number</label>
                        <input asp-for="Floor" type="number" class="form-control" value="7" min="1" max="15" />
                        <span asp-validation-for="Floor" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Equipment" class="form-label small fw-semibold text-light">Equipment / Facilities (comma-separated)</label>
                        <input asp-for="Equipment" class="form-control" placeholder="e.g. whiteboard, projector, AC, smart board" />
                        <span asp-validation-for="Equipment" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="BookingStatus" class="form-label small fw-semibold text-light">Initial Status</label>
                        <select asp-for="BookingStatus" class="form-select">
                            <option value="Available">Available</option>
                            <option value="Booked">Booked</option>
                            <option value="Maintenance">Under Maintenance</option>
                        </select>
                        <span asp-validation-for="BookingStatus" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-4 border-top border-secondary border-opacity-10">
                    <a asp-action="Index" class="btn btn-glass px-4">Cancel</a>
                    <button type="submit" class="btn btn-gradient-primary px-4 shadow">
                        <i class="bi bi-check2-circle me-1"></i> Save Room
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
