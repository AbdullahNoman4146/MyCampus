@model MyCampus.Models.CampusEvent

@{
    ViewData["Title"] = "Delete Event";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="glass-card p-4 p-md-5 border-danger border-opacity-25">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="stat-icon-wrapper" style="background: rgba(239, 68, 68, 0.12); color: #EF4444; width: 44px; height: 44px; font-size: 1.2rem;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-danger mb-0">Delete Event</h4>
                </div>
            </div>

            <p class="text-secondary small mb-4">
                Are you sure you want to permanently delete this event?
            </p>

            <div class="p-3 rounded-3 mb-4" style="background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.15);">
                <div class="fw-bold fs-5 text-white mb-1">@Model.Name</div>
                <div class="text-secondary small mb-2">@Model.Date.ToString("MMM dd, yyyy") at @Model.Time | Room @Model.Venue</div>
                <div class="text-light small">Organizer: @(string.IsNullOrEmpty(Model.Organizer) ? "Campus Club" : Model.Organizer) | Registered: @Model.RegisteredUsers / @Model.Capacity</div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.EventId">
                <input type="hidden" name="id" value="@Model.EventId" />
                <input type="hidden" asp-for="EventId" />
                <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary border-opacity-10">
                    <a asp-action="Index" class="btn btn-glass px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
