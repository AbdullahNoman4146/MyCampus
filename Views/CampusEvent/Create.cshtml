@model MyCampus.Models.CampusEvent

@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="glass-card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-wrapper" style="background: rgba(236, 72, 153, 0.15); color: #F472B6; width: 46px; height: 46px; font-size: 1.25rem;">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1 text-white">Organize New Campus Event</h3>
                        <p class="text-secondary small mb-0">Post a new hackathon, workshop, seminar, or university club activity</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-glass text-light">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger py-2 small rounded-3 mb-4" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label small fw-semibold text-light">Event Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. AUSTPIC AI Build Hackathon" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label small fw-semibold text-light">Event Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief summary of agenda, speakers, eligibility..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Date" class="form-label small fw-semibold text-light">Start Date <span class="text-danger">*</span></label>
                        <input asp-for="Date" type="date" class="form-control" required />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label small fw-semibold text-light">End Date (optional)</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StartTime" class="form-label small fw-semibold text-light">Start Time <span class="text-danger">*</span></label>
                        <input asp-for="StartTime" type="time" class="form-control" required />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndTime" class="form-label small fw-semibold text-light">End Time <span class="text-danger">*</span></label>
                        <input asp-for="EndTime" type="time" class="form-control" required />
                        <span asp-validation-for="EndTime" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Capacity" class="form-label small fw-semibold text-light">Max Capacity <span class="text-danger">*</span></label>
                        <input asp-for="Capacity" type="number" class="form-control" placeholder="60" min="1" required />
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Venue" class="form-label small fw-semibold text-light">Venue / Room <span class="text-danger">*</span></label>
                        <input asp-for="Venue" class="form-control" placeholder="e.g. 7C01 or Auditorium" required />
                        <span asp-validation-for="Venue" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Organizer" class="form-label small fw-semibold text-light">Organizer / Club</label>
                        <input asp-for="Organizer" class="form-control" placeholder="e.g. AUSTPIC or CSE Department" />
                        <span asp-validation-for="Organizer" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Status" class="form-label small fw-semibold text-light">Event Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="upcoming">Upcoming</option>
                            <option value="ongoing">Ongoing</option>
                            <option value="completed">Completed</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-4 border-top border-secondary border-opacity-10">
                    <a asp-action="Index" class="btn btn-glass px-4">Cancel</a>
                    <button type="submit" class="btn btn-gradient-primary px-4 shadow">
                        <i class="bi bi-check2-circle me-1"></i> Create Event
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
