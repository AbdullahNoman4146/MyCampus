@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center my-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="glass-card p-4 p-md-5 border-danger border-opacity-25" style="box-shadow: 0 8px 32px rgba(239, 68, 68, 0.08);">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="stat-icon-wrapper" style="background: rgba(239, 68, 68, 0.15); color: #EF4444; width: 48px; height: 48px; font-size: 1.25rem;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-danger mb-0">An Error Occurred</h4>
                    <p class="text-secondary small mb-0">We encountered an issue processing your request</p>
                </div>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="p-3 rounded-3 mb-4" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="text-secondary small mb-1">Request ID:</div>
                    <code class="text-info font-monospace">@Model.RequestId</code>
                </div>
            }

            <p class="text-secondary small mb-4">
                If you are running in Development mode, ensure the local database connection is active and check the console logs for detailed stack traces.
            </p>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary border-opacity-10">
                <a asp-controller="Home" asp-action="Index" class="btn btn-gradient-primary px-4">
                    <i class="bi bi-house me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
