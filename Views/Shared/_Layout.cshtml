@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyCampus</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyCampus.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar -->
        <aside id="appSidebar" class="app-sidebar">
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                <div class="brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div class="brand-text">
                    <span>MyCampus</span>
                </div>
            </a>

            <div class="sidebar-nav">
                <div class="nav-section-title">Navigation</div>

                <a asp-controller="Home" asp-action="Index" class="sidebar-link @(currentController == "Home" ? "active" : "")">
                    <i class="bi bi-grid link-icon"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Schedules" asp-action="Index" class="sidebar-link @(currentController == "Schedules" ? "active" : "")">
                    <i class="bi bi-calendar3 link-icon"></i>
                    <span>Schedule</span>
                </a>

                <a asp-controller="Rooms" asp-action="Index" class="sidebar-link @(currentController == "Rooms" ? "active" : "")">
                    <i class="bi bi-door-closed link-icon"></i>
                    <span>Rooms & Labs</span>
                </a>

                <a asp-controller="RoomBookings" asp-action="Index" class="sidebar-link @(currentController == "RoomBookings" ? "active" : "")">
                    <i class="bi bi-calendar-check link-icon"></i>
                    <span>Room Bookings</span>
                </a>

                <a asp-controller="CampusEvents" asp-action="Index" class="sidebar-link @(currentController == "CampusEvents" ? "active" : "")">
                    <i class="bi bi-flag link-icon"></i>
                    <span>Campus Events</span>
                </a>

                <a asp-controller="Assignments" asp-action="Index" class="sidebar-link @(currentController == "Assignments" ? "active" : "")">
                    <i class="bi bi-journal-text link-icon"></i>
                    <span>Assignments</span>
                </a>

                <a asp-controller="Announcements" asp-action="Index" class="sidebar-link @(currentController == "Announcements" ? "active" : "")">
                    <i class="bi bi-megaphone link-icon"></i>
                    <span>Announcements</span>
                </a>

                <div class="nav-section-title">AI Assistant</div>

                <a asp-controller="AiAgent" asp-action="Index" class="sidebar-link @(currentController == "AiAgent" ? "active" : "")">
                    <i class="bi bi-cpu link-icon"></i>
                    <span>AI Assistant</span>
                </a>
            </div>

            <!-- Sidebar Footer Widget -->
            <div class="sidebar-footer-card">
                <h6>AI Assistant</h6>
                <a asp-controller="AiAgent" asp-action="Index" class="btn-sidebar-ai">
                    <i class="bi bi-chat-dots me-1"></i> Ask Assistant
                </a>
            </div>
        </aside>

        <!-- Main Application Area -->
        <div class="app-main">
            <!-- Top Header -->
            <header class="app-header">
                <div class="header-left">
                    <button id="sidebarToggle" class="mobile-toggle" type="button" aria-label="Toggle navigation">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="header-title-box">
                        <h4>@(ViewData["Title"] ?? "Dashboard")</h4>
                    </div>
                </div>

                <!-- Global Search Box -->
                <div class="header-search">
                    <i class="bi bi-search search-icon"></i>
                    <form method="get" asp-controller="Schedules" asp-action="Index">
                        <input type="text" name="search" placeholder="Search classes, rooms, deadlines, notices..." autocomplete="off" />
                    </form>
                    <span class="search-kbd">Ctrl+K</span>
                </div>

                <!-- Header Right Actions (Student Profile Removed) -->
                <div class="header-right">
                    <a asp-controller="Announcements" asp-action="Index" class="header-btn" title="Announcements">
                        <i class="bi bi-bell"></i>
                    </a>

                    <a asp-controller="AiAgent" asp-action="Index" class="header-btn" title="AI Assistant">
                        <i class="bi bi-cpu"></i>
                    </a>
                </div>
            </header>

            <!-- Alerts Banner Area -->
            <div class="px-4 pt-3">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-dismissible fade show glass-card p-3 mb-0" style="border-left: 4px solid var(--accent-emerald);" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle" style="color: var(--accent-emerald); font-size: 1.1rem;"></i>
                            <span class="text-white fw-semibold">@TempData["SuccessMessage"]</span>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-dismissible fade show glass-card p-3 mb-0" style="border-left: 4px solid var(--accent-rose);" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-circle" style="color: var(--accent-rose); font-size: 1.1rem;"></i>
                            <span class="text-white fw-semibold">@TempData["ErrorMessage"]</span>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>

            <!-- Page Content Body -->
            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <!-- Minimal Footer -->
            <footer class="px-4 py-3 border-top text-center" style="border-color: var(--border-subtle) !important; color: var(--text-muted); font-size: 0.8rem;">
                &copy; 2026 <strong>MyCampus</strong>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Mobile sidebar toggle
        const sidebarToggle = document.getElementById('sidebarToggle');
        const appSidebar = document.getElementById('appSidebar');
        if (sidebarToggle && appSidebar) {
            sidebarToggle.addEventListener('click', () => {
                appSidebar.classList.toggle('show');
            });
        }
        // Keyboard shortcut Ctrl+K to focus search
        window.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                const searchInput = document.querySelector('.header-search input');
                if (searchInput) searchInput.focus();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
